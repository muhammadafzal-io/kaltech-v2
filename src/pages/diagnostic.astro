---
// Rebuilt in the homepage design system (home.css). Copy unchanged; values that
// feed a diagram live in src/data/diagnostic.json.
import Base from '../layouts/Base.astro';
import HomeHeader from '../components/home/HomeHeader.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import HomeCta from '../components/home/HomeCta.astro';
import Lenses3D from '../components/art/Lenses3D.astro';
import diagnostic from '../data/diagnostic.json';
import timelines from '../data/timelines.json';
import fit from '../data/fit.json';

const { incentive, lenses, phases, needs, returns } = diagnostic;
const set = fit.diagnostic;
const need = set.items.length - 1;

const heroPanel = [
  { label: 'Duration', value: 'Weeks, not months' },
  { label: 'Fee', value: 'Fixed, agreed upfront' },
  { label: 'Deliverable', value: 'A written finding' },
];
// A line icon per phase (decorative): interviews, evidence, the finding.
const phaseIcons = [
  '<path d="M4 5h11v8H8l-4 3z"/><path d="M15 9h5v8l-3-2h-6v-2"/>',
  '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  '<path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/><path d="M9 13l2 2 4-4"/>',
];
---

<Base
  title="A diagnostic of process, data and unit economics | KalTech"
  description="Every engagement begins with a diagnostic against process, data and unit economics. It ends in a written finding and a scope priced against it, for a fixed fee."
  breadcrumb={[{ name: 'Diagnostic', path: '/diagnostic' }]}
  chrome="own"
>
  <HomeHeader />

  <!-- Hero -->
  <section class="h-hero h-hero-sm h-dark" id="top" data-fx-hero>
    <div class="h-hero-bg" aria-hidden="true">
      <span class="h-hero-grid"></span>
      <span class="h-orb h-orb-a"></span>
      <span class="h-orb h-orb-b"></span>
    </div>
    <div class="h-wrap h-hero-inner">
      <div class="h-hero-copy">
        <p class="h-badge m-reveal"><span class="h-badge-dot" aria-hidden="true"></span>The diagnostic</p>
        <h1 class="h-h1 h-lines">
          <span class="h-line">Every engagement</span>
          <span class="h-line">begins with a</span>
          <span class="h-line"><em class="h-mark">diagnostic</em>.</span>
        </h1>
        <p class="h-lead m-reveal">
          Three lenses, one written finding, and a scope priced against it. Proceed or not, you keep
          the finding.
        </p>
        <div class="h-actions m-reveal">
          <a class="h-btn h-btn-primary" href="/contact" data-magnetic>
            <span>Get an AI Strategy Consult</span><span class="h-btn-arrow" aria-hidden="true">&#8594;</span>
          </a>
        </div>
        <dl class="dg-facts m-reveal">
          {heroPanel.map((i) => (
            <div><dt class="sv-label">{i.label}</dt><dd>{i.value}</dd></div>
          ))}
        </dl>
      </div>

      <div class="h-hero-viz">
        <Lenses3D lenses={lenses.map((l) => l.label)} hot={diagnostic.gate.bindingIndex} label="Three lenses in a row with a beam passing through them; the beam turns at the binding lens." />
      </div>
    </div>
  </section>

  <!-- Why it exists -->
  <section class="h-sec h-dark" id="why">
    <div class="h-dark-bg" aria-hidden="true"><span class="h-orb h-orb-c"></span></div>
    <div class="h-wrap dg-why">
      <div>
        <p class="h-eyebrow m-reveal">Why it exists</p>
        <h2 class="h-h2 m-reveal">A firm that builds should not be <span class="h-accent">trusted</span> to say what needs building.</h2>
        <p class="h-body dg-p m-reveal">
          So we charge for the finding as a document, not as the opening phase of a build. The fee covers
          the work whatever it concludes, including less than you asked for, or nothing at all.
        </p>
        <p class="h-body dg-p m-reveal">
          Free assessments recommend builds. The fee is not credited against one, because that would bring
          the incentive back.
        </p>
      </div>

      <div class="dg-inct">
        <div class="dg-inct-row dg-inct-head m-reveal">
          <span></span><span class="sv-label">Free assessment</span><span class="sv-label">Paid finding</span>
        </div>
        {
          incentive.map((r) => (
            <div class="dg-inct-row m-reveal">
              <span class="dg-inct-key">{r.key}</span>
              <span class="dg-inct-free"><span class="dg-inct-cell">Free assessment</span>{r.free}{'bars' in r && r.bars && <span class="dg-bar"><span style={`width:${Math.round(r.bars.free * 100)}%`}></span></span>}</span>
              <span class="dg-inct-paid"><span class="dg-inct-cell">Paid finding</span>{r.paid}{'bars' in r && r.bars && <span class="dg-bar"><span style={`width:${Math.round(r.bars.paid * 100)}%`}></span></span>}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- The three lenses -->
  <section class="h-sec h-bone" id="lenses">
    <div class="h-wrap">
      <div class="h-head">
        <div class="h-head-main">
          <h2 class="h-h2 m-reveal">Process, data, unit economics.</h2>
        </div>
        <p class="h-sub m-reveal">
          One of the three is usually binding. The diagnostic establishes which, what it costs, and what it
          would take to move.
        </p>
      </div>

      <div class="dg-lenses">
        {
          lenses.map((l, i) => (
            <article class={i === 0 ? 'dg-lens is-binding m-reveal' : 'dg-lens m-reveal'} data-spotlight>
              <div class="dg-lens-top">
                <p class="dg-lens-num">{l.num}</p>
                <p class="sv-label">{l.label}</p>
                <span class="dg-flag">{i === 0 ? diagnostic.gate.binding : diagnostic.gate.clear}</span>
              </div>
              <h3 class="h-h3">{l.heading}</h3>
              <p class="h-body">{l.body}</p>
              <p class="h-lens-ask"><strong>We ask:</strong> {l.ask}</p>
            </article>
          ))
        }
      </div>
      <p class="sv-cap m-reveal">
        An illustration. Which lens binds is what the diagnostic establishes.
      </p>
    </div>
  </section>

  <!-- How it runs -->
  <section class="h-sec h-white" id="runs">
    <div class="h-wrap">
      <div class="h-head">
        <div class="h-head-main">
          <p class="h-eyebrow m-reveal">How it runs</p>
          <h2 class="h-h2 m-reveal">What the <span class="h-accent">weeks</span> actually consist of.</h2>
        </div>
        <p class="h-sub m-reveal">
          Run by the engineers who would build against it, which is why it can be short. No discovery team,
          no second explanation.
        </p>
      </div>

      <div class="sv-bar m-reveal" role="img" aria-label="Access and interviews, then evidence, the longest phase, then the finding.">
        {timelines.diagnosticPhases.map((s) => <span class="sv-seg sv-seg-solid" style={`flex:${s.width}`}></span>)}
      </div>
      <p class="sv-gate m-reveal"><span class="sv-gate-mark" aria-hidden="true"></span>Three phases, one finding</p>

      <ol class="sv-steps dg-phases">
        {
          phases.map((ph) => (
            <li class="sv-step dg-phase m-reveal">
              <svg class="dg-phase-icon" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={phaseIcons[Number(ph.num) - 1]} />
              <p class="sv-step-num">{ph.num}</p>
              <h3 class="h-h3">{ph.title}</h3>
              <p class="h-body">{ph.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="sv-cap m-reveal">{timelines.caption}</p>

      <div class="dg-needs">
        <div>
          <p class="sv-label">What we need from you</p>
          <ul class="dg-needs-list">{needs.map((n) => <li class="h-body">{n}</li>)}</ul>
        </div>
        <div>
          <p class="sv-label">What we do not need</p>
          <p class="h-body">
            A brief, a requirements document, or a vendor evaluation. If one exists we will read it, and say
            where the finding disagrees.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What it returns -->
  <section class="h-sec h-bone" id="returns">
    <div class="h-wrap dg-returns">
      <div class="dg-ret-left">
        <h2 class="h-h2 m-reveal">What it <span class="h-accent">returns</span>.</h2>
        <div class="dg-facs m-reveal" aria-hidden="true">
          <p class="sv-label">KalTech Diagnostic Finding</p>
          <div class="dg-facs-lines">
            {
              returns.map((r) => (
                <p class="dg-facs-line">
                  <span class="dg-facs-num">{r.num}</span>
                  <span class="dg-facs-label">{r.short}</span>
                </p>
              ))
            }
          </div>
          <div class="dg-facs-greek"><i></i><i></i><i class="s"></i></div>
          <p class="sv-label">Written finding</p>
        </div>
      </div>

      <div class="dg-ret-right">
        {
          returns.map((r) => (
            <div class="dg-ret m-reveal">
              <p class="dg-ret-num">{r.num}</p>
              <div>
                <p class="dg-ret-head">{r.head}</p>
                <p class="h-body">{r.body}</p>
              </div>
            </div>
          ))
        }
        <p class="h-body dg-ret-note">
          Short, and written for someone who was not in the interviews. Clients take it to boards, lenders
          and their own technology teams. Every figure in it traces to something we saw, not something we
          were told.
        </p>
      </div>
    </div>
  </section>

  <!-- What it costs -->
  <section class="h-sec h-white" id="costs">
    <div class="h-wrap">
      <div class="h-head">
        <div class="h-head-main">
          <p class="h-eyebrow m-reveal">What it costs</p>
          <h2 class="h-h2 m-reveal">A <span class="h-accent">fixed fee</span>, agreed before the work starts.</h2>
        </div>
      </div>
      <div class="dg-cols">
        <div class="dg-big m-reveal">
          <p class="dg-big-fig">Fixed.</p>
          <p class="sv-label">Quoted after the first call, agreed before work starts</p>
        </div>
        <div>
          <p class="h-body dg-p">
            Not adjusted by what the work finds. The fee is the same whether the finding recommends a build, a
            smaller one, or none at all.
          </p>
          <p class="h-body dg-p">
            The scope that follows is priced separately, by the team that would deliver it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Useful when -->
  <section class="h-sec h-bone" id="fit">
    <div class="h-wrap">
      <div class="sv-fit" data-fit data-fit-threshold={need}>
        <div class="sv-fit-main">
          <h2 class="h-h2" id="fit-diagnostic-title">{set.title}</h2>
          <ul class="sv-fit-list" aria-labelledby="fit-diagnostic-title">
            {
              set.items.map((text) => (
                <li class="sv-fit-row">
                  <label class="sv-fit-label">
                    <input class="sv-fit-box" type="checkbox" data-fit-box data-js-control />
                    <span class="h-body">{text}</span>
                  </label>
                </li>
              ))
            }
          </ul>
        </div>
        <aside class="sv-fit-side" data-js-control style={`--n:${set.items.length}`}>
          <div class="sv-fit-ring">
            <p class="sv-fit-count" aria-live="polite"><span data-fit-n>0</span> of {set.items.length}</p>
            <span class="sv-fit-meter" aria-hidden="true">{set.items.map(() => <i class="mc-seg"></i>)}</span>
          </div>
          <p class="sv-fit-cta" data-fit-cta>
            <a class="h-btn h-btn-primary" href={fit.cta.href}><span>{fit.cta.label}</span><span class="h-btn-arrow" aria-hidden="true">&#8594;</span></a>
          </p>
        </aside>
      </div>
      <div class="sv-not">
        <h3 class="h-h3">{set.notTitle}</h3>
        <ul class="sv-not-list">{set.not.map((t) => <li class="h-body"><span class="sv-not-mark" aria-hidden="true"></span>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- A worked example -->
  <section class="h-sec h-dark" id="worked">
    <div class="h-dark-bg" aria-hidden="true"><span class="h-orb h-orb-c"></span></div>
    <div class="h-wrap">
      <div class="h-head">
        <div class="h-head-main">
          <p class="h-eyebrow m-reveal">A worked example</p>
          <h2 class="h-h2 m-reveal">What the finding <span class="h-accent">changed</span>.</h2>
        </div>
      </div>
      <div class="dg-cols dg-cols-top">
        <div>
          <p class="h-body dg-p">
            A consumer lender came in asking for a scoring model to shorten lending decisions. The brief named
            the model, the vendor shortlist and the launch quarter.
          </p>
          <p class="h-body dg-p">The diagnostic ran all three lenses. The binding one was process: two agents worked the same application in different orders.</p>
          <p class="h-body dg-p">
            The brief addressed a symptom. What was built was smaller than the brief. The system that removed the constraint came first,
            and the model followed once the inputs it depended on could be trusted.
          </p>
        </div>
        <div class="dg-delta m-reveal">
          <div class="dg-delta-row">
            <span class="sv-label">Scope requested &#183; Scoring model</span>
            <span class="dg-delta-bar"><i style="width:100%"></i></span>
          </div>
          <div class="dg-delta-row">
            <span class="sv-label">Scope delivered &#183; Process first, model second</span>
            <span class="dg-delta-bar dg-delta-hot"><i style="width:46%"></i></span>
          </div>
          <p class="sv-cap">The difference is what the diagnostic found.</p>
        </div>
      </div>
    </div>
  </section>

  <HomeCta />
  <HomeFooter />
</Base>
