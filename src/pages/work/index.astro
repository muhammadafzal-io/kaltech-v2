---
import CaseSlider from '../../components/home/CaseSlider.astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HomeHeader from '../../components/home/HomeHeader.astro';
import HomeFooter from '../../components/home/HomeFooter.astro';
import HomeCta from '../../components/home/HomeCta.astro';
import Screens3D from '../../components/art/Screens3D.astro';
import ImageWheel from '../../components/home/ImageWheel.astro';

const cases = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = (await getCollection('insights')).find((i) => i.data.featured && i.data.published)!;
const shots: Record<string, string> = {
  kalpay: '/work/kalpay-ui.svg',
  'ahw-global': '/work/ahw-global-shipments-ui.svg',
  becs: '/work/becs-inventory-ui.svg',
};
---

<Base
  title="Selected work in lending, logistics, blood banks | KalTech"
  description="Six engagements across lending, logistics, property, legal tech, blood banks and aesthetic clinics: the test that failed first, and what shipped against it."
  breadcrumb={[{ name: 'Work', path: '/work' }]}
  chrome="own"
>
  <HomeHeader />

  <section class="h-hero h-hero-sm h-dark" id="top" data-fx-hero>
    <div class="h-hero-bg" aria-hidden="true">
      <span class="h-hero-grid"></span>
      <span class="h-orb h-orb-a"></span>
      <span class="h-orb h-orb-b"></span>
    </div>
    <div class="h-wrap h-hero-inner">
      <div class="h-hero-copy">
        <p class="h-badge m-reveal"><span class="h-badge-dot" aria-hidden="true"></span>Selected Work</p>
        <h1 class="h-h1 h-lines">
          <span class="h-line">Every one of these</span>
          <span class="h-line">started with a <em class="h-mark">constraint</em>,</span>
          <span class="h-line">not a brief.</span>
        </h1>
        <p class="h-lead m-reveal">Six engagements, the test that failed first, and what shipped against it.</p>
      </div>

      <div class="h-hero-viz">
        <Screens3D
          cases={cases.map((c) => ({ title: c.data.title, figure: c.data.cardFigure }))}
          label="Six product screens on a platform, one per engagement, each showing its result."
        />
      </div>
    </div>
  </section>

  <section class="h-sec h-bone" id="cases">
    <div class="h-wrap">
      <div class="h-work-wheel">
        <ImageWheel cases={cases} featured={featured} />
      </div>

      <div class="h-bento cs-track m-reveal" tabindex="0" aria-label="Case studies, scroll sideways">
        {
          cases.map((c, i) => (
            <article class={`h-case h-case-${i + 1}`} id={c.id}>
              <div class="h-shot">
                <img class="h-shot-img" src={(shots[c.id] ?? '/work/case-placeholder.svg')} alt={c.data.imageCaption} width="1200" height="900" loading="lazy" decoding="async" />
              </div>
              <div class="h-case-body">
                <p class="h-case-pill">Constraint found &#8212; {c.data.constraintFound}</p>
                <h2 class="h-case-title">{c.data.title}</h2>
                <p class="h-case-industry">{c.data.industry}</p>
                {c.data.cardParas.map((p) => <p class="h-case-text">{p}</p>)}
                <div class="h-case-foot">
                  <div>
                    <p class="h-case-fig">
                      <span
                        class={c.data.cardCount !== null ? 'm-count' : undefined}
                        data-count={c.data.cardCount ?? undefined}
                        data-suffix={c.data.cardSuffix || undefined}
                        data-final={c.data.cardFigure}
                      >{c.data.cardFigure}</span>
                    </p>
                    <p class="h-case-figlabel">{c.data.cardFigureLabel}</p>
                  </div>
                  <a class="h-case-link" href={`/work/${c.id}`}>
                    <span>Read the <span class="visually-hidden">{c.data.title} </span>case study</span>
                    <span class="h-link-arrow" aria-hidden="true">&#8594;</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <CaseSlider count={cases.length} label="case study" />

      <blockquote class="h-pull h-pull-light m-reveal">
        Every engagement on this page began with a finding that contradicted the brief.
      </blockquote>
    </div>
  </section>

  <HomeCta />
  <HomeFooter />
</Base>
