---
// The site header. Transparent over the hero (every page opens on a dark or red
// hero); once scrolled, a compact frosted bar. motion.js sets data-scrolled.
// Logo left, the nav as a centred segmented pill, actions right.
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/diagnostic', label: 'Diagnostic' },
  { href: '/insights', label: 'Insights' },
  { href: '/about', label: 'About' },
];
const here = Astro.url.pathname;
const on = (href: string) => here === href || here.startsWith(href + '/');
---

<header class="hh" data-hdr slot="header">
  <div class="hh-bar">
    <a class="hh-logo" href="/" aria-label="KalTech, home">KalTech</a>

    <nav class="hh-nav" aria-label="Primary">
      <span class="hh-nav-glow" aria-hidden="true"></span>
      {nav.map((i) => <a class="hh-link" href={i.href} aria-current={on(i.href) ? 'page' : undefined}>{i.label}</a>)}
    </nav>

    <div class="hh-actions">

    <a class="hh-cta" href="/contact" data-magnetic>
      <span>Get an AI Strategy Consult</span>
      <span class="hh-cta-arrow" aria-hidden="true">&#8599;</span>
    </a>

    <details class="hh-menu" data-menu>
      <summary aria-label="Menu">
        <span class="hh-menu-open">Menu</span>
        <span class="hh-menu-close">Close</span>
      </summary>
      <div class="hh-panel">
        <nav class="hh-panel-nav" aria-label="Menu">
          {nav.map((i) => <a class="hh-panel-link" href={i.href} aria-current={on(i.href) ? 'page' : undefined}>{i.label}</a>)}
        </nav>
        <a class="h-btn h-btn-primary hh-panel-cta" href="/contact"><span>Get an AI Strategy Consult</span></a>
      </div>
    </details>
    </div>
  </div>
</header>
