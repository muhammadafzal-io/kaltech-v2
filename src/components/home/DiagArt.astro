---
// THE DIAGNOSTIC, in 3D. The business is a clear glass cylinder on a ringed
// platform; the constraint is an amber orb held inside it, visible only
// through the glass. A scanner ring travels up and down the cylinder, like a
// CT scan; as it passes the orb, the orb flares and target rings pulse out on
// the floor beneath it. Beside it, the written finding stands up and writes
// itself. Same stage as the other page artwork (.x3). No text: the parent is
// aria-hidden. Colour and motion live in home.css (.dg3-*).
const SIDES = 18;
const faces = Array.from({ length: SIDES }, (_, i) => (360 / SIDES) * i);
---

<figure class="x3 dg3">
  <div class="x3-stage">
    <span class="dg3-bloom"></span>
    <div class="x3-scene dg3-scene">
      <span class="dg3-floor"></span>
      <span class="dg3-target"><i></i><i></i><i></i></span>

      <span class="dg3-orb"><i></i></span>

      <div class="dg3-cyl" style={`--n:${SIDES}`}>
        {faces.map((a) => <span class="dg3-face" style={`--a:${a}deg`}></span>)}
        <span class="dg3-cap"></span>
        <span class="dg3-cap dg3-cap-base"></span>
      </div>

      <span class="dg3-scanner"></span>

      <div class="dg3-sheet-slot">
        <div class="dg3-sheet">
          <span class="dg3-line dg3-line-hot"></span>
          <span class="dg3-line"></span>
          <span class="dg3-line"></span>
          <span class="dg3-line dg3-line-short"></span>
          <span class="dg3-tick">&#10003;</span>
        </div>
      </div>

      <span class="dg3-spark dg3-spark-1"></span>
      <span class="dg3-spark dg3-spark-2"></span>
      <span class="dg3-spark dg3-spark-3"></span>
    </div>
  </div>
</figure>
