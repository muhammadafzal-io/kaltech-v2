---
// Controls for a horizontal case slider: previous / next, a counter and one
// dot per slide. The slider itself is CSS (scroll-snap) and scrolls by hand
// or by swipe without JavaScript; these controls only appear once the script
// runs (data-js-control). The script is bundled by Astro as an external file,
// which the CSP's 'self' already allows.
interface Props { count: number; label: string }
const { count, label } = Astro.props;
---

<div class="cs-nav" data-cs-nav data-js-control>
  <button class="cs-arrow" type="button" data-cs-prev aria-label={`Previous ${label}`}>&#8592;</button>
  <p class="cs-count" aria-live="polite"><span data-cs-n>01</span> / {String(count).padStart(2, '0')}</p>
  <div class="cs-dots" role="group" aria-label={`Choose a ${label}`}>
    {Array.from({ length: count }, (_, i) => <button class="cs-dot" type="button" data-cs-dot={i} aria-label={`${label} ${i + 1}`}></button>)}
  </div>
  <button class="cs-arrow" type="button" data-cs-next aria-label={`Next ${label}`}>&#8594;</button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-cs-nav]').forEach((nav) => {
    const track = nav.previousElementSibling as HTMLElement | null;
    if (!track) return;
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(nav.querySelectorAll<HTMLButtonElement>('[data-cs-dot]'));
    const n = nav.querySelector('[data-cs-n]');
    const prev = nav.querySelector<HTMLButtonElement>('[data-cs-prev]');
    const next = nav.querySelector<HTMLButtonElement>('[data-cs-next]');
    nav.classList.add('is-ready');
    track.classList.add('is-slider');

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const go = (i: number) => {
      const k = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: slides[k].offsetLeft - slides[0].offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
    };
    const current = () => {
      const x = track.scrollLeft;
      let best = 0;
      slides.forEach((s, i) => { if (Math.abs(s.offsetLeft - slides[0].offsetLeft - x) < Math.abs(slides[best].offsetLeft - slides[0].offsetLeft - x)) best = i; });
      return best;
    };
    const paint = () => {
      const i = current();
      if (n) n.textContent = String(i + 1).padStart(2, '0');
      dots.forEach((d, k) => d.toggleAttribute('aria-current', k === i));
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
    };
    prev?.addEventListener('click', () => go(current() - 1));
    next?.addEventListener('click', () => go(current() + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(current() - 1); }
    });
    let raf = 0;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(paint); }, { passive: true });
    paint();
  });
</script>
