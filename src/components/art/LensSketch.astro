---
// A small animated diagram per lens (decorative, no text):
//   process  one input, two routes, two different results
//   data     two systems, two different figures, not equal
//   economics value rising through the running-cost line: break-even
interface Props { kind: 'process' | 'data' | 'economics' }
const { kind } = Astro.props;
---

<svg class={`ls ls-${kind}`} viewBox="0 0 240 110" aria-hidden="true">
  {kind === 'process' && (
    <>
      <path class="ls-track" d="M24 55 C70 55, 80 26, 130 26 L206 26" />
      <path class="ls-track" d="M24 55 C70 55, 80 84, 130 84 L206 84" />
      <path class="ls-run ls-run-a" pathLength="1" d="M24 55 C70 55, 80 26, 130 26 L206 26" />
      <path class="ls-run ls-run-b" pathLength="1" d="M24 55 C70 55, 80 84, 130 84 L206 84" />
      <circle class="ls-node" cx="24" cy="55" r="7" />
      <rect class="ls-end ls-end-a" x="200" y="18" width="16" height="16" rx="4" />
      <circle class="ls-end ls-end-b" cx="208" cy="84" r="8" />
    </>
  )}
  {kind === 'data' && (
    <>
      <g class="ls-db">
        <ellipse cx="50" cy="26" rx="26" ry="8" /><path d="M24 26v52c0 4.4 11.6 8 26 8s26-3.6 26-8V26" /><path d="M24 52c0 4.4 11.6 8 26 8s26-3.6 26-8" />
      </g>
      <g class="ls-db">
        <ellipse cx="190" cy="26" rx="26" ry="8" /><path d="M164 26v52c0 4.4 11.6 8 26 8s26-3.6 26-8V26" /><path d="M164 52c0 4.4 11.6 8 26 8s26-3.6 26-8" />
      </g>
      <rect class="ls-bar ls-bar-a" x="92" y="36" width="10" height="50" rx="3" />
      <rect class="ls-bar ls-bar-b" x="138" y="50" width="10" height="36" rx="3" />
      <g class="ls-neq"><path d="M112 50h16M112 62h16" /><path d="M126 42l-12 28" /></g>
    </>
  )}
  {kind === 'economics' && (
    <>
      <path class="ls-axis" d="M20 92H224M20 92V12" />
      <path class="ls-cost" d="M20 58H224" />
      <path class="ls-track" d="M20 88 C70 84, 100 72, 130 58 S190 22, 224 16" />
      <path class="ls-run ls-run-v" pathLength="1" d="M20 88 C70 84, 100 72, 130 58 S190 22, 224 16" />
      <circle class="ls-cross" cx="130" cy="58" r="6" />
    </>
  )}
</svg>
