---
// A field of light ribbons: fifteen curves gathered at a point on the left
// and fanning out to the right, each a soft glow under a bright core. An
// original drawing in the brand reds; decorative. Motion lives in home.css.
const N = 15;
const ribbons = Array.from({ length: N }, (_, i) => {
  const t = i / (N - 1);                 // 0..1 top to bottom
  const spread = (t - 0.5) * 2;          // -1..1
  const x0 = 300 + Math.sin(i * 1.7) * 30;
  const y0 = 470 + Math.cos(i * 2.3) * 30;
  const x3 = 1250;
  const y3 = 450 + spread * 420;
  const c1x = 420 + Math.sin(i) * 60, c1y = y0 - 140 * Math.cos(i * 0.9);
  const c2x = 760, c2y = y3 - spread * 260 + Math.sin(i * 1.3) * 120;
  return { d: `M${x0.toFixed(0)} ${y0.toFixed(0)} C${c1x.toFixed(0)} ${c1y.toFixed(0)}, ${c2x} ${c2y.toFixed(0)}, ${x3} ${y3.toFixed(0)}`, hot: i % 4 === 1, i };
});
---

<div class="rf" aria-hidden="true">
  <svg viewBox="0 0 1200 900" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="rf-g" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="currentColor" stop-opacity="0" />
        <stop offset="0.25" stop-color="currentColor" stop-opacity="1" />
        <stop offset="1" stop-color="currentColor" stop-opacity="0.15" />
      </linearGradient>
      <filter id="rf-blur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="9" /></filter>
    </defs>
    <g class="rf-glow" filter="url(#rf-blur)">
      {ribbons.map((r) => <path d={r.d} />)}
    </g>
    <g class="rf-lines">
      {ribbons.map((r) => <path class={r.hot ? 'is-hot' : ''} d={r.d} style={`--i:${r.i}`} />)}
    </g>
    <g class="rf-runs">
      {ribbons.filter((r) => r.hot).map((r) => <path pathLength="1" d={r.d} style={`--i:${r.i}`} />)}
    </g>
  </svg>
</div>
